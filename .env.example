# notification-service — every variable the service reads (SPEC-PLAT-06 R78). Copy to .env (git-ignored).
# Values below are DEV-ONLY and target the growercare-local-platform network (container hostnames).

# --- required (no defaults; the service refuses to start without them)
# JDBC URL of the gc_notification database
DB_URL=jdbc:postgresql://postgres:5432/gc_notification
# runtime role (DML only) and its password (secret)
DB_APP_USER=gc_notification_app
DB_APP_PASSWORD=dev_notification_app_pw
# expected token issuer (iss claim) and where signing keys are fetched
OIDC_ISSUER_URI=http://localhost:8180/realms/growercare
OIDC_JWKS_URI=http://keycloak:8180/realms/growercare/protocol/openid-connect/certs
# Keycloak clients allowed to send messages (SPEC-NOT-01 R7)
GC_INTERNAL_CLIENTS=grower-service

# --- providers (SPEC-NOT-01 D2/D3): LOCAL ONLY, messages are stored in the dev mailbox instead of being sent
# default false; never true where real providers are configured
GC_DEV_MAILBOX=true
GC_SMS_PROVIDER=mailbox
GC_WHATSAPP_PROVIDER=mailbox
GC_EMAIL_PROVIDER=mailbox

# --- migrations (only where they run: locally, or the pre-deploy Job)
# default false
GC_MIGRATE=true
DB_OWNER_USER=gc_notification_owner
DB_OWNER_PASSWORD=dev_notification_owner_pw

# --- optional tunables (safe defaults)
SERVER_PORT=8085
DB_POOL_SIZE=10
GC_CORS_ALLOWED_ORIGINS=http://localhost:5173
GC_API_DOCS_ENABLED=true
JAVA_TOOL_OPTIONS=-Xmx384m
