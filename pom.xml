<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- ADR-017: an independent service; the shared build and libraries come by version from GitHub Packages. -->
  <parent>
    <groupId>com.growercare</groupId>
    <artifactId>gc-parent</artifactId>
    <version>1.0.0</version>
    <relativePath/>
  </parent>

  <artifactId>notification-service</artifactId>
  <version>${revision}</version>
  <name>notification-service</name>
  <description>Message dispatch (SMS / WhatsApp / email) through provider ports, templates per language, and the local dev mailbox for GrowerCare</description>

  <properties>
    <revision>1.0.0-SNAPSHOT</revision>
  </properties>

  <repositories>
    <repository>
      <id>github</id>
      <name>GitHub Packages (growercare-platform-libs)</name>
      <url>https://maven.pkg.github.com/manjunathyadavs1998/growercare-platform-libs</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency><groupId>org.springdoc</groupId><artifactId>springdoc-openapi-starter-webmvc-ui</artifactId></dependency>
    <dependency><groupId>com.growercare</groupId><artifactId>gc-common</artifactId></dependency>
    <dependency><groupId>com.growercare</groupId><artifactId>gc-security</artifactId></dependency>
    <dependency><groupId>com.growercare</groupId><artifactId>gc-outbox</artifactId></dependency>
    <!-- SPEC-NOT-02: case events (consumer + DLQ) and contact lookups with a client-credentials token -->
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-kafka</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-security-oauth2-client</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-jdbc</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-flyway</artifactId></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-actuator</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-validation</artifactId></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>com.growercare</groupId><artifactId>gc-test-support</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-webmvc-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.awaitility</groupId><artifactId>awaitility</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Image: mvn package jib:dockerBuild (local) · CI: jib:build to GHCR (SPEC-PLAT-06 R79) -->
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <configuration>
          <container>
            <ports><port>8085</port></ports>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
